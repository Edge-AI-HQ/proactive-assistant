{
  "_comment": "Build-time warmup config. Mirrors the proactive-ai runtime config (apis/src/domain/container/providers/shared/openclaw_config.ts buildOpenclawConfig) closely enough that the same set of bundled plugins activate during build as at runtime. Two side effects we want: (1) V8 compiles the production module graph into NODE_COMPILE_CACHE, (2) OpenClaw's own plugin loader stages every missing runtime dep into OPENCLAW_PLUGIN_STAGE_DIR — so cold container starts skip the 5-reload SIGUSR1 install storm.",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback"
  },
  "messages": {
    "tts": { "auto": "off" }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "http://127.0.0.1:4000",
        "apiKey": "warmup-dummy",
        "api": "openai-completions",
        "models": [
          { "id": "claude-opus-4-6", "name": "Claude Opus 4.6" }
        ]
      },
      "openai": {
        "baseUrl": "http://127.0.0.1:4000",
        "apiKey": "warmup-dummy",
        "models": []
      },
      "anthropic": {
        "baseUrl": "http://127.0.0.1:4000",
        "apiKey": "warmup-dummy",
        "models": []
      },
      "moonshot": {
        "baseUrl": "http://127.0.0.1:4000",
        "apiKey": "warmup-dummy",
        "models": []
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm/claude-opus-4-6"
      },
      "models": {
        "litellm/claude-opus-4-6": { "alias": "opus" }
      },
      "elevatedDefault": "full"
    }
  },
  "skills": {
    "load": { "extraDirs": ["/opt/pinai/skills"] }
  },
  "plugins": {
    "_comment": "The Dockerfile warmup step dynamically inserts an `enabled: true` entry for every bundled plugin under /usr/local/lib/node_modules/openclaw/dist/extensions/, so we don't list them here. Use `enabled: false` here to opt a specific plugin out of the build-time bake.",
    "entries": {
      "platform-hooks": { "enabled": true },
      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "warmup-dummy",
            "baseUrl": "http://127.0.0.1:4000",
            "model": "sonar-pro"
          }
        }
      },
      "browser": { "enabled": false }
    },
    "load": {
      "paths": [
        "/opt/pinai/plugins/platform-hooks"
      ]
    }
  },
  "tools": {
    "profile": "full",
    "allow": ["*"],
    "deny": [],
    "elevated": { "enabled": true, "allowFrom": { "*": ["*"] } },
    "exec": {
      "security": "full",
      "host": "gateway",
      "ask": "off",
      "backgroundMs": 10000,
      "timeoutSec": 1800,
      "notifyOnExit": true
    },
    "web": {
      "search": { "enabled": true, "maxResults": 10, "provider": "perplexity" },
      "fetch": { "enabled": true, "maxChars": 50000 }
    },
    "media": {
      "concurrency": 2,
      "audio": {
        "enabled": true,
        "maxBytes": 20971520,
        "models": [
          { "provider": "openai", "model": "gpt-4o-mini-transcribe", "baseUrl": "http://127.0.0.1:4000" }
        ]
      },
      "image": {
        "enabled": true,
        "models": [
          { "provider": "moonshot", "model": "kimi-k2.5", "baseUrl": "http://127.0.0.1:4000" }
        ]
      },
      "video": {
        "enabled": true,
        "maxBytes": 52428800,
        "models": [
          { "provider": "moonshot", "model": "kimi-k2.5", "baseUrl": "http://127.0.0.1:4000" }
        ]
      }
    },
    "sessions": { "visibility": "all" },
    "loopDetection": { "enabled": false }
  },
  "commands": {
    "native": true,
    "text": true,
    "bash": true,
    "config": true,
    "debug": true,
    "restart": true
  },
  "browser": {
    "enabled": false
  },
  "cron": {
    "enabled": true
  }
}
