{
  "name": "@pin-ai/apis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "NODE_ENV=development tsx src/server.ts",
    "dev:watch": "NODE_ENV=development tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "litellm:up": "cd .. && bash ops/litellm/litellm.sh up",
    "litellm:restart": "cd .. && bash ops/litellm/litellm.sh restart",
    "litellm:logs": "cd .. && bash ops/litellm/litellm.sh logs",
    "litellm:cleanup-local-db": "cd .. && bash ops/litellm/litellm.sh cleanup-local-db",
    "litellm:verify-db-env": "cd .. && bash ops/litellm/litellm.sh verify-db-env",
    "test:fly-api": "node scripts/test-fly-api.mjs",
    "test:create-container": "node scripts/test-create-container.mjs",
    "db:migrate": "node scripts/run-migration.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.31.0",
    "http-proxy": "^1.18.1",
    "mysql2": "^3.19.0",
    "pg": "^8.13.3",
    "stripe": "^14.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
