# ── Core ──
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ── Auth ──
API_INTERNAL_TOKEN=

# ── Database ──
SUPABASE_DB_URL=

# ── Container runtime ──
# docker (本地开发) 或 fly (线上部署)
CONTAINER_RUNTIME=docker
# OPENCLAW_IMAGE=pinai-openclaw:latest

# ── LiteLLM ──
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=

# ── Payment / Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PUBLIC_BASE_URL=
CRON_SECRET=

# ── Provider API keys (不会注入用户容器) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
BRAVE_API_KEY=

# ── Feature flags ──
ALLOW_MISSING_SECRETS=false
