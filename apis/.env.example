# Unified backend API server env

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Internal API auth:
# - API_INTERNAL_TOKEN protects generic /api/* endpoints
#   and payment internal endpoints.
API_INTERNAL_TOKEN=

# Telegram auth/gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Core infrastructure
SUPABASE_DB_URL=
OPENCLAW_API_KEY=
CONTAINER_RUNTIME=docker

# LiteLLM core
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_CONTAINER_BASE_URL=http://host.docker.internal:4000
LITELLM_MASTER_KEY=

# Payment/Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID 从 billing_plans.stripe_price_id 读取，无需配置
PAYMENT_PUBLIC_BASE_URL=
CRON_SECRET=

# Optional provider keys (never injected into user/assistant container runtime)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
BRAVE_API_KEY=

# Feature flags
ALLOW_MISSING_SECRETS=false

# Optional advanced tuning (defaults are defined in code)
# OPENCLAW_IMAGE=pinai-openclaw:latest
# OPENCLAW_GATEWAY_PORT=18789
# CONTAINER_PORT_START=20000
# CONTAINER_PORT_END=22000
# CONTAINER_MEMORY_MB=2048
# CONTAINER_CPU_SHARES=512
# FLY_API_TOKEN=
# FLY_APP_NAME=
# FLY_REGION 单区域或逗号分隔列表，资源不足时按顺序尝试；如 yyz,cdg,lhr,gru
# FLY_REGION=yyz,cdg,lhr,gru
# FLY_API_BASE_URL=https://api.machines.dev/v1
# FLY_VOLUME_SIZE_GB=20
# FLY_VOLUME_NAME_PREFIX=openclaw-user
# FLY_MACHINE_CPUS=1
# FLY_GATEWAY_PROBE=true
# FLY_GATEWAY_PROBE_TIMEOUT_MS=120000
# LITELLM_REQUEST_TIMEOUT_MS=15000
# LITELLM_SYNC_INTERVAL_MS=300000
# LITELLM_KEY_ALIAS_PREFIX=claw-assistant-
# LITELLM_DEFAULT_BUDGET_USD=0
# LITELLM_DEFAULT_BUDGET_DURATION=30d
# LITELLM_DEFAULT_RPM_LIMIT=
# LITELLM_DEFAULT_TPM_LIMIT=
# LITELLM_ALLOWED_MODELS=
# LITELLM_OPENCLAW_DEFAULT_MODEL=claude-opus-4-6
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# XI_API_KEY=
# PAYMENT_REQUEST_TIMEOUT_MS=10000
