# ── Core ──
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ── Auth ──
API_INTERNAL_TOKEN=

# ── Database ──
SUPABASE_DB_URL=

# ── Container runtime ──
# docker (local) or fly (deployed)
CONTAINER_RUNTIME=docker
# OPENCLAW_IMAGE=pinai-openclaw:latest

# ── LiteLLM ──
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=
LITELLM_ALLOWED_MODELS=
LITELLM_OPENCLAW_DEFAULT_MODEL=

# ── Payment / Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PUBLIC_BASE_URL=
CRON_SECRET=

# ── Feature flags ──
ALLOW_MISSING_SECRETS=false

# ── Proactive AI ──
SUPABASE_URL=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Fly (only when CONTAINER_RUNTIME=fly) ──
# FLY_API_TOKEN=
# FLY_ASSISTANT_APP_NAME=
# FLY_REGION=iad
