# Legacy/standalone LiteLLM env template.
# The default docker-compose profile reads ./apps/pinclaw-bot/.env directly.
# Use this file only if you run LiteLLM image manually.

SUPABASE_DB_URL=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Optional provider keys (at least one is recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
