{
	"appId": "ai.pin.proactive",
	"appName": "PIN AI",
	"webDir": "dist",
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#F1F3F7"
	},
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#F2F0F5"
		},
		"Keyboard": {
			"resize": "none",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"alert",
				"badge",
				"sound"
			]
		}
	},
	"packageClassList": [
		"SecureStorage",
		"ContactsPlugin",
		"CapacitorSQLitePlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"DevicePlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"CapacitorBarometerPlugin",
		"HealthPlugin",
		"AmbientModelsPlugin",
		"AudioCapturePlugin",
		"CalendarPlugin",
		"DeviceStatePlugin",
		"GeocoderPlugin",
		"MediaNotebookPlugin",
		"NearbyConnectivityPlugin",
		"NotificationUsagePlugin",
		"VisitMonitorPlugin"
	]
}
