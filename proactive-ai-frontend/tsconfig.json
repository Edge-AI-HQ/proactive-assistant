{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pin/capacitor-ambient-ai": ["../capacitor-plugins/ambient-ai/src/index.ts"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"]
}
