# Capacitor（iOS / Android）打包时 Vite 会把以 VITE_ 开头的变量打进 bundle。
# 复制本文件为同目录下的 .env.production.local（已被 .gitignore 忽略），填入真实值后再执行：
#   npm run cap:ios
#
# 与 Web 不同：原生没有同源反向代理，必须写云端 backend 的绝对地址。

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# backend 后端公网 URL（不要尾斜杠），native bundle 调 /api/* 用
VITE_PIN_API_URL=https://YOUR_PINAI_AGENTS_HOST
