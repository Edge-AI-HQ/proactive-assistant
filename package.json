{
  "name": "pin-ai-assistant-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-patches.mjs",
    "type-check": "npm run type-check --workspace=@pin-ai/web",
    "lint:packages": "eslint packages",
    "check:packages": "npm run lint:packages && npm run type-check --workspace=@pin-ai/core --workspace=@pin-ai/state --workspace=@pin-ai/ui-kit --workspace=@pin-ai/ui-web && npm test --workspace=@pin-ai/core --workspace=@pin-ai/state --workspace=@pin-ai/ui-kit --workspace=@pin-ai/ui-web",
    "build": "npm run build --workspace=@pin-ai/web",
    "mobile-sync:ngrok": "node scripts/mobile-sync-ngrok.mjs",
    "litellm:up": "bash ops/litellm/litellm.sh up",
    "litellm:restart": "bash ops/litellm/litellm.sh restart",
    "litellm:logs": "bash ops/litellm/litellm.sh logs",
    "litellm:cleanup-local-db": "bash ops/litellm/litellm.sh cleanup-local-db",
    "litellm:verify-db-env": "bash ops/litellm/litellm.sh verify-db-env"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.72.0",
    "eslint": "^10.4.1",
    "patch-package": "^8.0.1",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
