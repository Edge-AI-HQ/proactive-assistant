{
  "name": "pin-ai-assistant-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apis",
    "apps/pinclaw-bot"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pin-ai/apis",
    "dev:bot": "npm run dev --workspace @pin-ai/pinclaw-bot",
    "dev:api": "npm run dev --workspace @pin-ai/apis",
    "build": "npm run build --workspace @pin-ai/apis && npm run build --workspace @pin-ai/pinclaw-bot",
    "start": "npm run start --workspace @pin-ai/apis",
    "start:bot": "npm run start --workspace @pin-ai/pinclaw-bot",
    "type-check": "npm run type-check --workspace @pin-ai/apis && npm run type-check --workspace @pin-ai/pinclaw-bot",
    "lint": "npm run lint --workspace @pin-ai/pinclaw-bot",
    "hash-password": "npm run hash-password --workspace @pin-ai/pinclaw-bot --",
    "litellm:up": "bash ops/litellm/litellm.sh up",
    "litellm:restart": "bash ops/litellm/litellm.sh restart",
    "litellm:logs": "bash ops/litellm/litellm.sh logs",
    "litellm:cleanup-local-db": "bash ops/litellm/litellm.sh cleanup-local-db",
    "litellm:verify-db-env": "bash ops/litellm/litellm.sh verify-db-env"
  }
}
