{
  "name": "pin-ai-assistant-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/pinclaw-bot",
    "apps/payment-gateway",
    "infra/container-manager",
    "infra/litellm",
    "infra/supabase",
    "infra/payment"
  ],
  "scripts": {
    "build:infra": "npm run build --workspace @pin-ai/infra-supabase && npm run build --workspace @pin-ai/infra-litellm && npm run build --workspace @pin-ai/infra-container-manager",
    "type-check:infra": "npm run build:infra",
    "dev": "npm run build:infra && npm run dev --workspace @pin-ai/pinclaw-bot",
    "build": "npm run build:infra && npm run build --workspace @pin-ai/pinclaw-bot",
    "start": "npm run start --workspace @pin-ai/pinclaw-bot",
    "type-check": "npm run type-check:infra && npm run type-check --workspace @pin-ai/pinclaw-bot",
    "type-check:payment": "npm run type-check --workspace @pin-ai/payment-gateway && npm run type-check --workspace @pin-ai/infra-payment",
    "lint": "npm run lint --workspace @pin-ai/pinclaw-bot",
    "hash-password": "npm run hash-password --workspace @pin-ai/pinclaw-bot --",
    "dev:payment": "npm run dev --workspace @pin-ai/payment-gateway",
    "build:payment": "npm run build --workspace @pin-ai/payment-gateway",
    "dev:payment-backend": "npm run dev --workspace @pin-ai/infra-payment",
    "build:payment-backend": "npm run build --workspace @pin-ai/infra-payment",
    "deploy:payment": "npm run deploy --workspace @pin-ai/payment-gateway",
    "deploy:payment-backend": "npm run deploy --workspace @pin-ai/infra-payment",
    "litellm:up": "npm run service:up --workspace @pin-ai/infra-litellm",
    "litellm:restart": "npm run service:restart --workspace @pin-ai/infra-litellm",
    "litellm:logs": "npm run service:logs --workspace @pin-ai/infra-litellm",
    "litellm:cleanup-local-db": "npm run service:cleanup-local-db --workspace @pin-ai/infra-litellm",
    "litellm:verify-db-env": "npm run service:verify-db-env --workspace @pin-ai/infra-litellm"
  }
}
