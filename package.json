{
  "name": "pin-ai-assistant-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "proactive-ai-frontend"
  ],
  "scripts": {
    "type-check": "npm run type-check --workspace=@pin-ai/proactive-ai-frontend",
    "build": "npm run build --workspace=@pin-ai/proactive-ai-frontend",
    "mobile-sync:ngrok": "node scripts/mobile-sync-ngrok.mjs",
    "litellm:up": "bash ops/litellm/litellm.sh up",
    "litellm:restart": "bash ops/litellm/litellm.sh restart",
    "litellm:logs": "bash ops/litellm/litellm.sh logs",
    "litellm:cleanup-local-db": "bash ops/litellm/litellm.sh cleanup-local-db",
    "litellm:verify-db-env": "bash ops/litellm/litellm.sh verify-db-env"
  }
}
