{
  "name": "pin-ai-assistant-monorepo",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apis",
    "miniapp"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pin-ai/apis",
    "build": "npm run build --workspace @pin-ai/apis",
    "build:miniapp": "npm run build --workspace @pin-ai/miniapp",
    "build:all": "npm run build --workspace @pin-ai/miniapp && npm run build --workspace @pin-ai/apis",
    "start": "npm run start --workspace @pin-ai/apis",
    "type-check": "npm run type-check --workspace @pin-ai/apis",
    "type-check:miniapp": "npm run type-check --workspace @pin-ai/miniapp",
    "litellm:up": "bash ops/litellm/litellm.sh up",
    "litellm:restart": "bash ops/litellm/litellm.sh restart",
    "litellm:logs": "bash ops/litellm/litellm.sh logs",
    "litellm:cleanup-local-db": "bash ops/litellm/litellm.sh cleanup-local-db",
    "litellm:verify-db-env": "bash ops/litellm/litellm.sh verify-db-env"
  }
}
