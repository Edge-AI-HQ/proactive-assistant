# Local-only env for PIN-AI-ASSISTANT worktrees.
# Copy from ~/.config/pinai/repos/pin-ai-assistant.env into repo-root .env.local

NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001

# Local Postgres
SUPABASE_DB_URL=postgresql://postgres:password@127.0.0.1:55432/pinai_local

# Local Telegram test bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ROUTER_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.dev/webhook/telegram

# Local container runtime
CONTAINER_RUNTIME=docker

# Local model auth
ANTHROPIC_API_KEY=

# Optional but usually needed by local APIs boot
API_INTERNAL_TOKEN=
LITELLM_MASTER_KEY=
STRIPE_SECRET_KEY=
