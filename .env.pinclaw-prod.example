# Telegram (pinclaw-prod main guide bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=PINClaw_AI_bot

# Anthropic / OpenClaw
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
OPENCLAW_API_KEY=
OPENCLAW_IMAGE=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HTTP_PATH=/v1/chat/completions
OPENCLAW_WS_PATH=/
ELEVENLABS_API_KEY=
XI_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v1

# Server
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/db.sqlite
PUBLIC_BASE_URL=https://pinclaw-prod.fly.dev
API_DOMAIN=api.pinai.io

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_SECRET=

# Containers / Fly
CONTAINER_RUNTIME=fly
CONTAINER_PORT_START=20000
CONTAINER_PORT_END=22000
CONTAINER_MEMORY_MB=2048
CONTAINER_CPU_SHARES=512
FLY_API_BASE_URL=https://api.machines.dev/v1
FLY_API_TOKEN=
FLY_APP_NAME=pinclaw-prod
FLY_REGION=iad
FLY_VOLUME_SIZE_GB=20
FLY_VOLUME_NAME_PREFIX=openclaw-user
FLY_MACHINE_CPUS=1
FLY_GATEWAY_PROBE=true
FLY_GATEWAY_PROBE_TIMEOUT_MS=120000
