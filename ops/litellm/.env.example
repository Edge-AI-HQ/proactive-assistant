# LiteLLM runtime env template.
# docker-compose 使用此文件；Fly 部署时用 fly secrets set。
#
# 可与 apis 共用同一库：在连接串末尾加 ?options=-c%20search_path%3Dlitellm
# 这样 LiteLLM 的表都在 litellm schema，不碰 public 下的业务表。
LITELLM_DB_URL=
LITELLM_MASTER_KEY=

# ── Provider keys (至少填一个) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
ELEVENLABS_API_KEY=
PERPLEXITYAI_API_KEY=
