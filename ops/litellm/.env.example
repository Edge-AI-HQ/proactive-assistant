# LiteLLM runtime env template.
# docker-compose 使用此文件；Fly 部署时用 fly secrets set。
#
# 可与 apis 共用同一库：先在该库执行 CREATE SCHEMA IF NOT EXISTS litellm; 再在连接串末尾加：
#   ?options=-c%20search_path%3Dlitellm
# 这样 LiteLLM 的表都在 litellm schema，不会动 public 下的 users/assistants 等。
# 若用独立库，直接填连接串即可，无需加 options。
DATABASE_URL=

# Fly 部署时的 app 名（set-fly-db 命令用）
# LITELLM_FLY_APP=pinclaw-litellm
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Optional provider keys (at least one is recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
