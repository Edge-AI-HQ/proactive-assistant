# LiteLLM runtime env template.
# docker-compose 使用此文件；Fly 部署时用 fly secrets set。
# 与 apis 共用同一库，只配这一个即可（config + Prisma 都用）
DATABASE_URL=

# Fly 部署时的 app 名（set-fly-db 命令用）
# LITELLM_FLY_APP=pinclaw-litellm
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Optional provider keys (at least one is recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
