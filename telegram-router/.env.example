# Telegram Router 环境变量

# 从 PIN-AI-ASSISTANT/.env 复制
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<YOUR_TELEGRAM_WEBHOOK_SECRET>

# Supabase PostgreSQL 连接
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# OpenClaw Telegram webhook endpoint in assistant machines
OPENCLAW_TELEGRAM_WEBHOOK_PORT=8787
OPENCLAW_TELEGRAM_WEBHOOK_PATH=/telegram-webhook
FLY_APP_NAME=pinclaw-api-dev
