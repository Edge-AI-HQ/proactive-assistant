# Telegram
# Use token from any BotFather-created bot (bot username is customizable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.pinai.io/auth/google/callback

# Anthropic / OpenClaw
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
OPENCLAW_API_KEY=
OPENCLAW_IMAGE=pinai-openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HTTP_PATH=/v1/chat/completions
OPENCLAW_HTTP_MODE=openai
OPENCLAW_WS_PATH=/

# Server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/db.sqlite
PUBLIC_BASE_URL=http://localhost:3000
API_DOMAIN=api.pinai.io

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_SECRET=

# Containers
CONTAINER_PORT_START=20000
CONTAINER_PORT_END=22000
CONTAINER_MEMORY_MB=2048
CONTAINER_CPU_SHARES=512
