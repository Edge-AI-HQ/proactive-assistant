# Telegram
# Use token from any BotFather-created bot (bot username is customizable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional fallback for web Telegram login widget.
TELEGRAM_BOT_USERNAME=

# Anthropic / OpenClaw
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
OPENCLAW_API_KEY=
OPENCLAW_IMAGE=pinai-openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HTTP_PATH=/v1/chat/completions
OPENCLAW_WS_PATH=/
ELEVENLABS_API_KEY=
XI_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v1

# LiteLLM (per-bot virtual key + spend tracking)
LITELLM_ENABLED=false
# Used by this control-plane service to call LiteLLM admin APIs.
LITELLM_BASE_URL=http://127.0.0.1:4000
# Used inside assistant OpenClaw containers to route model traffic via LiteLLM.
LITELLM_CONTAINER_BASE_URL=http://host.docker.internal:4000
# Used only when `pin-ai-assistant` runs inside docker-compose with LiteLLM profile.
LITELLM_BASE_URL_IN_DOCKER=http://litellm:4000
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_KEY_ENCRYPTION_SECRET=
LITELLM_REQUEST_TIMEOUT_MS=15000
LITELLM_SYNC_INTERVAL_MS=300000
LITELLM_USER_ID_PREFIX=pinai-user-
LITELLM_KEY_ALIAS_PREFIX=pinai-assistant-
LITELLM_DEFAULT_BUDGET_USD=
LITELLM_DEFAULT_BUDGET_DURATION=30d
LITELLM_DEFAULT_RPM_LIMIT=
LITELLM_DEFAULT_TPM_LIMIT=
LITELLM_ALLOWED_MODELS=
LITELLM_OPENCLAW_DEFAULT_MODEL=claude-opus-4-6
LITELLM_ALLOW_PROVIDER_FALLBACK=false
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=litellm_change_me
LITELLM_POSTGRES_DB=litellm

# Server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/db.sqlite
PUBLIC_BASE_URL=http://localhost:3000
API_DOMAIN=api.pinai.io

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_SECRET=

# Containers
CONTAINER_RUNTIME=docker
CONTAINER_PORT_START=20000
CONTAINER_PORT_END=22000
CONTAINER_MEMORY_MB=2048
CONTAINER_CPU_SHARES=512

# Fly.io Runtime (when CONTAINER_RUNTIME=fly)
FLY_API_BASE_URL=https://api.machines.dev/v1
FLY_API_TOKEN=
FLY_APP_NAME=
FLY_REGION=iad
FLY_VOLUME_SIZE_GB=20
FLY_VOLUME_NAME_PREFIX=openclaw-user
FLY_MACHINE_CPUS=1
FLY_GATEWAY_PROBE=true
FLY_GATEWAY_PROBE_TIMEOUT_MS=120000

# Optional integrations
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
