# Project-root .env — per-developer local overrides.
#
# Copy to ./.env and fill in your values. ./.env is gitignored;
# never commit your authtoken or anything personal here.
#
# This file is read AUTOMATICALLY by docker compose for variable
# interpolation in docker-compose.yml. It is NOT touched by
# `make ensure-env` (that one only manages pinai-agents/.env and
# ops/litellm/.env, which are decrypted from dotenvx-encrypted SSOT).
#
# ─────────────────────────────────────────────────────────────────────
# ngrok tunnel — exposes local pinai-web to the public internet so
# Daytona cloud sandboxes can reach `/api/agent/*` via pinai_sdk.
# Required when running the generator agent locally; optional otherwise.
#
# First-time setup:
#   1. Sign up at https://dashboard.ngrok.com/signup (free).
#   2. Copy your authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
#   3. Reserve a static domain (free tier: 1 per account):
#      https://dashboard.ngrok.com/domains  →  "+ New Domain"
#   4. Paste authtoken + domain below.
#   5. PAI_API_URL = "https://" + your domain.
#   6. Run: make tunnel-up
# ─────────────────────────────────────────────────────────────────────

NGROK_AUTHTOKEN=
NGROK_DOMAIN=
PAI_API_URL=
