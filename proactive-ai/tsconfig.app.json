{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/ui/*"],
      "@shared/*": ["./src/types/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src/ui/**/*.ts", "src/ui/**/*.tsx", "src/types/**/*.ts"]
}
