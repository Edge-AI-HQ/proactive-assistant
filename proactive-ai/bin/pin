#!/usr/bin/env node
/**
 * Stable CLI entry point for OpenClaw agents.
 *
 * Prefers compiled dist/ (fast, ~0ms). Falls back to tsx (always
 * matches source, ~150ms) — negligible vs agent LLM calls.
 *
 * gateway.ts adds this directory to PATH so OpenClaw's hasBinary("pin")
 * finds it and agents can run `pin ...` as a shell command.
 */

import { execFileSync } from 'node:child_process';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { existsSync } from 'node:fs';

const __dirname = dirname(fileURLToPath(import.meta.url));
const projectRoot = resolve(__dirname, '..');

const compiled = resolve(projectRoot, 'dist', 'src', 'cli', 'bin.js');
if (existsSync(compiled)) {
  await import(compiled);
} else {
  const tsx = resolve(projectRoot, 'node_modules', '.bin', 'tsx');
  const source = resolve(projectRoot, 'src', 'cli', 'bin.ts');
  try {
    execFileSync(tsx, [source, ...process.argv.slice(2)], {
      stdio: 'inherit',
      env: process.env,
    });
  } catch (err) {
    process.exit(err.status ?? 1);
  }
}
