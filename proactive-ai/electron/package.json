{
  "name": "proactive-ai-desktop",
  "version": "2.0.0",
  "description": "Proactive AI — macOS desktop app",
  "main": "dist/main.js",
  "scripts": {
    "setup": "cd .. && npm install && cd electron && npm install",
    "build": "tsc",
    "dev": "npm run build:ui --prefix .. && tsc && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev:hmr": "node dev-hmr.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "package": "tsc && electron-forge package",
    "make": "tsc && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@types/node": "^22.0.0",
    "electron": "^40.8.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@buape/carbon": "^0.14.0",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@slack/web-api": "^7.15.0",
    "openclaw": "^2026.4.5"
  }
}
