{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/ui/*"],
      "@shared/*": ["./src/types/*"]
    }
  }
}
