{
  "name": "@pin-ai/pin-cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pin": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js"
    },
    "./envelope": {
      "types": "./dist/src/output/envelope.d.ts",
      "import": "./dist/src/output/envelope.js"
    }
  },
  "dependencies": {
    "@pin-ai/core": "*",
    "@lancedb/lancedb": "^0.27.2",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.33.0"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "rm -rf ../../skills && cp -r skills ../../skills",
    "type-check": "tsc --noEmit",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
"dev": "node --import tsx src/bin.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  }
}
