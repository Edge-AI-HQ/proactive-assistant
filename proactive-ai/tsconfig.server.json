{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src/core/**/*.ts",
    "src/cli/**/*.ts",
    "src/engine/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
