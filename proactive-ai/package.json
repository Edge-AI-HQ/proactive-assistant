{
  "name": "pin-ai/proactive-ai",
  "version": "2.0.0",
  "type": "module",
  "description": "OpenClaw plugin — Intent card generation pipeline with Planner/Generator/Evaluator agents",
  "main": "index.ts",
  "bin": {
    "pin": "./bin/pin"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "main": "dist/index.js",
    "openclaw": {
      "extensions": [
        "./dist/index.js"
      ]
    }
  },
  "files": [
    "bin/",
    "dist/",
    "openclaw.plugin.json",
    "skills/"
  ],
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json && chmod +x dist/src/cli/bin.js",
    "build": "npm run build:server && npm run build:ui",
    "type-check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.33.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.83.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.21.5",
    "framer-motion": "^11.0.0",
    "jsdom": "^20.0.3",
    "lucide-react": "^0.462.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vaul": "^0.9.9",
    "vite": "^5.4.19",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^3.2.4"
  }
}
