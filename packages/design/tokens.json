{
  "colors": {
    "background": "hsl(var(--background))",
    "foreground": "hsl(var(--foreground))",
    "card": {
      "DEFAULT": "hsl(var(--card))",
      "foreground": "hsl(var(--card-foreground))"
    },
    "primary": {
      "DEFAULT": "hsl(var(--primary))",
      "foreground": "hsl(var(--primary-foreground))"
    },
    "muted": {
      "DEFAULT": "hsl(var(--muted))",
      "foreground": "hsl(var(--muted-foreground))"
    },
    "border": "hsl(var(--border))",
    "ring": "hsl(var(--ring))",
    "secondary": {
      "DEFAULT": "hsl(var(--secondary))",
      "foreground": "hsl(var(--secondary-foreground))"
    },
    "destructive": {
      "DEFAULT": "hsl(var(--destructive))",
      "foreground": "hsl(var(--destructive-foreground))"
    },
    "accent": {
      "DEFAULT": "hsl(var(--accent))",
      "foreground": "hsl(var(--accent-foreground))"
    },
    "popover": {
      "DEFAULT": "hsl(var(--popover))",
      "foreground": "hsl(var(--popover-foreground))"
    },
    "input": "hsl(var(--input))"
  },
  "borderRadius": {
    "lg": "var(--radius)",
    "md": "calc(var(--radius) - 2px)",
    "sm": "calc(var(--radius) - 4px)"
  },
  "cssVariables": "\n  --background: 220 30% 96%;\n  --foreground: 230 25% 15%;\n  --card: 0 0% 100%;\n  --card-foreground: 230 25% 15%;\n  --primary: 292 78% 63%;\n  --primary-foreground: 0 0% 100%;\n  --muted: 220 15% 90%;\n  --muted-foreground: 220 10% 50%;\n  --border: 220 20% 88%;\n  --ring: 292 78% 63%;\n  --radius: 1.25rem;\n  --glass-bg: 0 0% 100% / 0.55;\n  --glass-border: 0 0% 100% / 0.6;\n  --glass-shadow: 280 20% 60% / 0.06;\n  --glow-primary: 292 78% 63%;\n  --glow-success: 145 60% 50%;\n  --glow-warning: 35 90% 55%;\n  --glow-alert: 0 72% 60%;\n  --secondary: 220 20% 92%;\n  --secondary-foreground: 230 25% 15%;\n  --destructive: 0 72% 60%;\n  --destructive-foreground: 0 0% 100%;\n  --accent: 292 78% 63%;\n  --accent-foreground: 0 0% 100%;\n  --popover: 0 0% 100%;\n  --popover-foreground: 230 25% 15%;\n  --input: 220 20% 88%;\n",
  "letterSpacingEm": {
    "tight": -0.025,
    "display": -0.02
  },
  "typeScale": {
    "display": {
      "fontSize": 30,
      "lineHeight": 1.05,
      "letterSpacing": -0.02
    },
    "title": {
      "fontSize": 24,
      "lineHeight": 1.1,
      "letterSpacing": -0.02
    },
    "heading": {
      "fontSize": 20,
      "lineHeight": 1.2,
      "letterSpacing": -0.015
    },
    "subheading": {
      "fontSize": 17,
      "lineHeight": 1.3,
      "letterSpacing": -0.01
    },
    "body": {
      "fontSize": 15,
      "lineHeight": 1.45,
      "letterSpacing": 0
    },
    "bodySm": {
      "fontSize": 13,
      "lineHeight": 1.45,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": 12,
      "lineHeight": 1.35,
      "letterSpacing": 0
    },
    "caption": {
      "fontSize": 11,
      "lineHeight": 1.35,
      "letterSpacing": 0
    },
    "micro": {
      "fontSize": 10,
      "lineHeight": 1.4,
      "letterSpacing": 0
    }
  },
  "fontWeight": {
    "regular": {
      "web": 400,
      "native": "Inter_400Regular"
    },
    "medium": {
      "web": 500,
      "native": "Inter_500Medium"
    },
    "semibold": {
      "web": 600,
      "native": "Inter_600SemiBold"
    },
    "bold": {
      "web": 700,
      "native": "Inter_700Bold"
    }
  },
  "motion": {
    "duration": {
      "instant": 100,
      "fast": 150,
      "base": 200,
      "slow": 300,
      "slower": 500
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "decelerate": [
        0,
        0,
        0,
        1
      ],
      "accelerate": [
        0.3,
        0,
        1,
        1
      ]
    },
    "spring": {
      "damping": 20,
      "stiffness": 300,
      "mass": 1
    }
  },
  "elevation": {
    "sm": {
      "y": 1,
      "blur": 2,
      "opacity": 0.06
    },
    "md": {
      "y": 4,
      "blur": 12,
      "opacity": 0.08
    },
    "lg": {
      "y": 8,
      "blur": 24,
      "opacity": 0.12
    }
  }
}
