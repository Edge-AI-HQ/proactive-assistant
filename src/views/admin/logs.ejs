<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>系统日志</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui; }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="max-w-5xl mx-auto px-6 py-10">
      <header class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold">系统日志</h1>
          <p class="text-sm text-slate-500">最近消息记录</p>
        </div>
        <a href="/admin/dashboard" class="rounded-xl border border-slate-200 px-4 py-2 text-sm">返回</a>
      </header>

      <section class="mt-6 space-y-3">
        <% if (logs.length === 0) { %>
          <p class="text-slate-500">暂无日志</p>
        <% } %>
        <% logs.forEach((log) => { %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <p class="text-xs uppercase tracking-widest text-slate-400"><%= log.created_at %> · <%= log.direction %></p>
            <p class="mt-2 text-sm"><%= log.message_text %></p>
          </div>
        <% }) %>
      </section>
    </main>
  </body>
</html>
