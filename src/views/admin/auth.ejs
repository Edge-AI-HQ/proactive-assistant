<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>认证策略</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui; }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="max-w-6xl mx-auto px-6 py-10">
      <header class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold">认证策略</h1>
          <p class="text-sm text-slate-500">管理 Google 登录允许的域名与邮箱</p>
        </div>
        <a href="/admin/dashboard" class="rounded-xl border border-slate-200 px-4 py-2 text-sm">返回</a>
      </header>

      <% if (notice) { %>
        <p class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-700"><%= notice %></p>
      <% } %>
      <% if (error) { %>
        <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700"><%= error %></p>
      <% } %>

      <section class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">默认域名</p>
          <p class="mt-2 text-2xl font-semibold"><%= policy.defaultAllowedDomains.length %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">自定义域名</p>
          <p class="mt-2 text-2xl font-semibold"><%= policy.customDomainEntries.length %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">自定义邮箱</p>
          <p class="mt-2 text-2xl font-semibold"><%= policy.customEmailEntries.length %></p>
        </div>
      </section>

      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold">默认策略（环境变量）</h2>
        <p class="mt-1 text-sm text-slate-500">这些值来自服务配置，只读显示。</p>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <p class="text-xs uppercase tracking-widest text-slate-400">默认域名</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <% if (policy.defaultAllowedDomains.length === 0) { %>
                <span class="text-sm text-slate-500">无</span>
              <% } %>
              <% policy.defaultAllowedDomains.forEach((domain) => { %>
                <span class="rounded-full border border-slate-300 px-3 py-1 text-xs"><%= domain %></span>
              <% }) %>
            </div>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-slate-400">默认邮箱</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <% if (policy.defaultAllowedEmails.length === 0) { %>
                <span class="text-sm text-slate-500">无</span>
              <% } %>
              <% policy.defaultAllowedEmails.forEach((email) => { %>
                <span class="rounded-full border border-slate-300 px-3 py-1 text-xs"><%= email %></span>
              <% }) %>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold">新增允许域名</h2>
          <p class="mt-1 text-sm text-slate-500">输入纯域名，不需要加 @。例如：gmail.com</p>
          <form class="mt-4 flex gap-3" method="POST" action="/admin/auth/domains">
            <input
              name="domain"
              placeholder="gmail.com"
              class="flex-1 rounded-xl border border-slate-300 px-4 py-2 text-sm"
              required
            >
            <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm text-white">添加</button>
          </form>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold">新增允许邮箱</h2>
          <p class="mt-1 text-sm text-slate-500">输入完整邮箱地址。该邮箱即使域名未开放也可登录。</p>
          <form class="mt-4 flex gap-3" method="POST" action="/admin/auth/emails">
            <input
              name="email"
              placeholder="friend@gmail.com"
              class="flex-1 rounded-xl border border-slate-300 px-4 py-2 text-sm"
              required
            >
            <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm text-white">添加</button>
          </form>
        </div>
      </section>

      <section class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold">自定义域名列表</h2>
          <div class="mt-4 space-y-3">
            <% if (policy.customDomainEntries.length === 0) { %>
              <p class="text-sm text-slate-500">暂无自定义域名</p>
            <% } %>
            <% policy.customDomainEntries.forEach((entry) => { %>
              <div class="flex items-center justify-between rounded-xl border border-slate-200 px-4 py-3">
                <div>
                  <p class="text-sm font-medium"><%= entry.value %></p>
                  <p class="text-xs text-slate-500"><%= entry.created_at %></p>
                </div>
                <form method="POST" action="/admin/auth/entries/<%= entry.id %>/delete">
                  <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs">删除</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold">自定义邮箱列表</h2>
          <div class="mt-4 space-y-3">
            <% if (policy.customEmailEntries.length === 0) { %>
              <p class="text-sm text-slate-500">暂无自定义邮箱</p>
            <% } %>
            <% policy.customEmailEntries.forEach((entry) => { %>
              <div class="flex items-center justify-between rounded-xl border border-slate-200 px-4 py-3">
                <div>
                  <p class="text-sm font-medium"><%= entry.value %></p>
                  <p class="text-xs text-slate-500"><%= entry.created_at %></p>
                </div>
                <form method="POST" action="/admin/auth/entries/<%= entry.id %>/delete">
                  <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs">删除</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
