{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pin-ai/core": ["../../packages/core/src/index.ts"],
      "@pin-ai/state": ["../../packages/state/src/index.ts"],
      "@pin-ai/ui-web": ["../../packages/ui-web/src/index.ts"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"]
}
