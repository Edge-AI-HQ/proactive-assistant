{
  "name": "@pin-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PIN AI macOS desktop shell (Electron) — renderer reuses the proactive-ai-frontend React DOM UI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "type-check": "tsc --noEmit",
    "package": "electron-vite build && electron-builder --mac --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0"
  }
}
