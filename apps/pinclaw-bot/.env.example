# pinclaw-bot env
# Copy to apps/pinclaw-bot/.env

# Required
TELEGRAM_BOT_TOKEN=
SUPABASE_DB_URL=
OPENCLAW_API_KEY=
ADMIN_PASSWORD_HASH=

# Optional AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
ELEVENLABS_API_KEY=
# Backward-compatible alias for ELEVENLABS_API_KEY
XI_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Telegram/auth
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
PUBLIC_BASE_URL=

# Service
PORT=3000
NODE_ENV=development

# Admin
ADMIN_USERNAME=admin
ADMIN_SESSION_TTL_HOURS=12

# Container runtime
CONTAINER_RUNTIME=docker
OPENCLAW_IMAGE=pinai-openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
CONTAINER_PORT_START=20000
CONTAINER_PORT_END=22000
CONTAINER_MEMORY_MB=2048
CONTAINER_CPU_SHARES=512

# Fly runtime (when CONTAINER_RUNTIME=fly)
FLY_API_TOKEN=
FLY_APP_NAME=
FLY_REGION=iad
# Optional Fly tuning
FLY_API_BASE_URL=https://api.machines.dev/v1
FLY_VOLUME_SIZE_GB=20
FLY_VOLUME_NAME_PREFIX=openclaw-user
FLY_MACHINE_CPUS=1
FLY_GATEWAY_PROBE=true
FLY_GATEWAY_PROBE_TIMEOUT_MS=120000

# LiteLLM integration (pinclaw-bot side)
LITELLM_ENABLED=true
# Host-mode default; docker-compose overrides this to http://litellm:4000.
LITELLM_BASE_URL=http://127.0.0.1:4000
# Used in assistant containers (launched via host Docker API).
LITELLM_CONTAINER_BASE_URL=http://host.docker.internal:4000
LITELLM_MASTER_KEY=
# Required when running LiteLLM docker-compose profile locally.
LITELLM_SALT_KEY=
LITELLM_KEY_ENCRYPTION_SECRET=
# Optional LiteLLM tuning
LITELLM_REQUEST_TIMEOUT_MS=15000
LITELLM_SYNC_INTERVAL_MS=300000
LITELLM_USER_ID_PREFIX=pinai-user-
LITELLM_KEY_ALIAS_PREFIX=pinai-assistant-
LITELLM_DEFAULT_BUDGET_USD=
LITELLM_DEFAULT_BUDGET_DURATION=30d
LITELLM_DEFAULT_RPM_LIMIT=
LITELLM_DEFAULT_TPM_LIMIT=
LITELLM_ALLOWED_MODELS=
LITELLM_OPENCLAW_DEFAULT_MODEL=claude-opus-4-6

# Payment API (pinclaw-bot -> infra/payment)
PAYMENT_ENABLED=false
# Set this to infra/payment base URL.
PAYMENT_SERVICE_BASE_URL=
# Shared with infra/payment PAYMENT_SERVICE_API_KEY.
PAYMENT_SERVICE_API_KEY=
PAYMENT_REQUEST_TIMEOUT_MS=10000

# Feature flags
ALLOW_MISSING_SECRETS=false
