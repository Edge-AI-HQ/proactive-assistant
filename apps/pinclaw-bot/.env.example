# pinclaw-bot frontend env
# Copy to apps/pinclaw-bot/.env

# Required
TELEGRAM_BOT_TOKEN=
BACKEND_API_BASE_URL=http://127.0.0.1:3000

# Internal API auth:
# - Should match apis API_INTERNAL_TOKEN.
API_INTERNAL_TOKEN=

# Telegram/webhook/public URL
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Optional explicit webhook URL, e.g. https://example.com/webhook/telegram
TELEGRAM_WEBHOOK_URL=
# auto (default) | webhook | polling
TELEGRAM_UPDATE_MODE=auto
PUBLIC_BASE_URL=

# Bot frontend service
PORT=3001
NODE_ENV=development

# Enable /subscribe command
PAYMENT_ENABLED=true

# Feature flags
ALLOW_MISSING_SECRETS=false

# Optional advanced tuning
# BACKEND_API_REQUEST_TIMEOUT_MS=10000
