<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>用户详情</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui; }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="max-w-5xl mx-auto px-6 py-10">
      <header class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold">用户详情</h1>
          <p class="text-sm text-slate-500">Telegram ID: <%= user.telegram_user_id %> / @<%= user.telegram_username || '未知' %></p>
        </div>
        <a href="/admin/users" class="rounded-xl border border-slate-200 px-4 py-2 text-sm">返回</a>
      </header>

      <section class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">容器状态</p>
          <p class="mt-2 text-lg font-semibold"><%= user.container_status %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">容器端口</p>
          <p class="mt-2 text-lg font-semibold"><%= user.container_port %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-widest text-slate-400">Gateway Token</p>
          <p class="mt-2 text-xs break-all"><%= user.gateway_token %></p>
        </div>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold">Assistant Bots / LiteLLM</h2>
        <% if (!assistants || assistants.length === 0) { %>
          <p class="mt-4 text-sm text-slate-500">暂无 assistant bot 记录</p>
        <% } else { %>
          <div class="mt-4 overflow-auto">
            <table class="w-full text-sm">
              <thead class="bg-slate-100 text-left text-xs uppercase tracking-widest text-slate-500">
                <tr>
                  <th class="px-3 py-2">Bot</th>
                  <th class="px-3 py-2">Container</th>
                  <th class="px-3 py-2">LiteLLM Key Alias</th>
                  <th class="px-3 py-2">Spend</th>
                  <th class="px-3 py-2">Budget</th>
                  <th class="px-3 py-2">Last Sync</th>
                </tr>
              </thead>
              <tbody>
                <% assistants.forEach((assistant) => { %>
                  <tr class="border-t border-slate-100">
                    <td class="px-3 py-2">
                      @<%= assistant.assistant_bot_username %><br>
                      <span class="text-xs text-slate-500">id=<%= assistant.assistant_bot_id %></span>
                    </td>
                    <td class="px-3 py-2"><%= assistant.container_status %> / <%= assistant.container_port %></td>
                    <td class="px-3 py-2 font-mono text-xs"><%= assistant.litellm_key_alias || '-' %></td>
                    <td class="px-3 py-2">$<%= Number(assistant.litellm_spend_usd || 0).toFixed(4) %></td>
                    <td class="px-3 py-2">
                      <% if (assistant.litellm_budget_usd === null || assistant.litellm_budget_usd === undefined) { %>
                        -
                      <% } else { %>
                        $<%= Number(assistant.litellm_budget_usd).toFixed(2) %>
                      <% } %>
                    </td>
                    <td class="px-3 py-2"><%= assistant.litellm_last_synced_at || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="mt-6 flex flex-wrap gap-3">
        <form method="POST" action="/admin/users/<%= user.id %>/restart">
          <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm text-white">重启容器</button>
        </form>
        <form method="POST" action="/admin/users/<%= user.id %>/stop">
          <button class="rounded-xl border border-slate-200 px-4 py-2 text-sm">停止容器</button>
        </form>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold">容器日志</h2>
        <pre class="mt-4 whitespace-pre-wrap text-xs text-slate-700 bg-slate-50 rounded-xl p-4 max-h-96 overflow-auto"><%= logs || '暂无日志' %></pre>
      </section>
    </main>
  </body>
</html>
