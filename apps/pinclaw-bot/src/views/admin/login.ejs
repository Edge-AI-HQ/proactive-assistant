<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PIN AI Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'IBM Plex Sans', ui-sans-serif, system-ui; }
    </style>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white">
    <main class="max-w-md mx-auto px-6 py-20">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-xl">
        <h1 class="text-2xl font-semibold">PIN AI 管理后台</h1>
        <p class="mt-2 text-sm text-slate-300">仅限内部团队访问</p>
        <% if (error) { %>
          <p class="mt-4 rounded-xl bg-red-500/20 px-4 py-2 text-sm text-red-100"><%= error %></p>
        <% } %>
        <form class="mt-6 space-y-4" method="POST" action="/admin/login">
          <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">用户名</label>
            <input name="username" class="mt-2 w-full rounded-xl border border-white/10 bg-white/10 px-4 py-2 text-sm" required>
          </div>
          <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">密码</label>
            <input name="password" type="password" class="mt-2 w-full rounded-xl border border-white/10 bg-white/10 px-4 py-2 text-sm" required>
          </div>
          <button class="w-full rounded-xl bg-white py-2 text-sm font-semibold text-slate-900">登录</button>
        </form>
      </div>
    </main>
  </body>
</html>
