{
  "name": "@pin-ai/pin-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pin": "./dist/src/bin.js"
  },
  "dependencies": {
    "@composio/core": "^0.6.8",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "dev": "node --import tsx src/bin.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10"
  }
}
